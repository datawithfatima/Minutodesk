# Copia este archivo como .env y ajusta los valores. .env NO se sube a git.

# Clave para firmar las sesiones. Si no la defines, se genera una automáticamente
# y se guarda en backend/.secret_key (también ignorado por git).
SECRET_KEY=

# URL donde corre el frontend (se usa para armar los enlaces de los correos).
FRONTEND_URL=http://localhost:5173

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Correo (activación de cuentas y "olvidé mi contraseña") ---
# Sin SMTP_HOST los correos no se envían: se guardan en backend/correos_enviados/
# (modo desarrollo). Ejemplo con Gmail (requiere verificación en 2 pasos y una
# "contraseña de aplicación", NO tu contraseña normal):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-correo-de-pruebas@gmail.com
# SMTP_PASSWORD=contraseña-de-aplicación
# SMTP_FROM=tu-correo-de-pruebas@gmail.com
# Para un servidor SMTP local de pruebas sin cifrado (p. ej. Mailpit en el puerto 1025):
# SMTP_TLS=0
